# Koneksi Postgres — SETIAP komputer klien connect langsung ke server ini,
# tidak ada backend/API perantara (lihat Khanza.md > "Arsitektur UI & Koneksi Data").
PGHOST=localhost
PGPORT=5432
PGDATABASE=khanza
PGUSER=khanza_app
PGPASSWORD=ubah_ini

# Secret buat sign JWT sesi login (BEDA dari public key verifikasi lisensi di LisensiService.js)
JWT_SECRET=ubah_ini_juga

# Base URL server lisensi Khanza (lihat Khanza.md > "Aktivasi Lisensi").
# Ini BUKAN server pos-desktop (poswarung.my.id) — harus backend lisensi milik Khanza sendiri.
LISENSI_BASE_URL=https://lisensi.khanza.example/api

# Set ke 1 HANYA kalau komputer ini gagal launch proses GPU Electron (gejala:
# FATAL "GPU process isn't usable" saat `npm run dev`/app dibuka) — biasanya
# kejadian di VM/thin-client/GPU tua. Biarkan kosong/0 di komputer normal biar
# tetap dapat akselerasi hardware (lihat main/index.js).
KHANZA_DISABLE_GPU=0

# MinIO — object storage buat file lampiran (lihat Khanza.md > "Arsitektur
# Hybrid WebView" bagian MinIO). Cuma dipegang main process (main/electron/MinioService.js),
# renderer TIDAK pernah connect langsung, sama seperti Postgres. Nilai di
# bawah ini default instalasi lokal standar — sesuaikan ke server MinIO
# beneran saat deploy ke RS.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=0
MINIO_BUCKET=khanza
